# Normalise line endings; scripts and workflows must stay LF so they run on every runner.
* text=auto eol=lf

*.sh      text eol=lf
makefile  text eol=lf
Makefile  text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.pdf  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary

# Lockfiles are generated: keep them out of diffs and conflict-free merges.
uv.lock         -diff linguist-generated
Cargo.lock      -diff linguist-generated
package-lock.json -diff linguist-generated
pnpm-lock.yaml  -diff linguist-generated
bun.lock        -diff linguist-generated
yarn.lock       -diff linguist-generated

# Large binaries: uncomment to track with Git LFS (https://git-lfs.com).
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.mp4 filter=lfs diff=lfs merge=lfs -text
