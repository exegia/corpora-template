# Copy to .env with `make env-init`. .env is gitignored and must never be committed.
# Every value here is a placeholder and is allowlisted in .gitleaks.toml.
# `make env-check` diffs the keys of .env against this file; `make secrets-push` loads a
# dotenv file into GitHub secrets. Delete the sections your project does not use.

# ── Local development ───────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info

# ── Third-party APIs (rename for your project) ──────────────────────────────
EXAMPLE_API_KEY=REPLACE_ME
EXAMPLE_TOKEN=REPLACE_ME

# ── AI agents and LLM providers ─────────────────────────────────────────────
ANTHROPIC_API_KEY=REPLACE_ME
OPENAI_API_KEY=REPLACE_ME

# ── Expo / EAS ──────────────────────────────────────────────────────────────
EXPO_TOKEN=REPLACE_ME

# ── Apple / App Store Connect (SwiftUI, Expo) ───────────────────────────────
APP_STORE_CONNECT_KEY_ID=REPLACE_ME
APP_STORE_CONNECT_ISSUER_ID=REPLACE_ME

# ── Publishing (used as CI secrets in the matching GitHub environment) ──────
NPM_TOKEN=REPLACE_ME
CARGO_REGISTRY_TOKEN=REPLACE_ME
